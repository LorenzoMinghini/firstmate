# never per poll.
wedge_timer_check() {  # <window> <since-file> <triage-label> <escalation-count-file> <task> <hash>
  local win=$1 since_file=$2 label=$3 escalation_file=$4 task=$5 hash=$6 since age n reason permanent_marker marker_ts
